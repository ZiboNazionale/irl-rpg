{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": ["/favicon.ico", "/index.csr.html", "/index.html", "/manifest.webmanifest", "/*.css", "/*.js"]
      }
    },
    {
      "name": "immagini",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/icons/**", "/**/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"]
      }
    },
    {
      "name": "modelli-3d",
      "installMode": "lazy",
      "updateMode": "lazy",
      "resources": {
        "files": ["/modelli/**/*.glb", "/modelli/*.json"]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "font",
      "urls": ["https://fonts.googleapis.com/**", "https://fonts.gstatic.com/**"],
      "cacheConfig": { "strategy": "performance", "maxSize": 20, "maxAge": "365d" }
    }
  ]
}
